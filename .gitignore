# =============================================================================
# HaWoR base — materialized (as relative symlinks) from the pinned
# thirdparty/hawor_upstream submodule via scripts/setup/fetch_hawor_base.sh. EgoSmith
# uses HaWoR as a component; HaWoR-authored code is NOT redistributed (these are
# pointers into the submodule, gitignored, never tracked — and no patches).
# =============================================================================
# top-level hawor package (utils/configs) — whole-dir symlink to the submodule
/src/hawor
/thirdparty/hawor/
src/infiller/lib/
src/lib/models/backbones/
src/lib/models/components/
src/lib/models/mano_wrapper.py
src/lib/models/modules.py
src/lib/models/hawor.py
src/lib/core/constants.py
src/lib/datasets/track_dataset.py
src/lib/eval_utils/custom_utils.py
src/lib/eval_utils/filling_utils.py
src/lib/eval_utils/video_utils.py
src/lib/pipeline/est_scale.py
src/lib/pipeline/tools.py
src/lib/utils/geometry.py
src/lib/utils/imutils.py
src/lib/vis/renderer.py
src/lib/vis/renderer_world.py
src/lib/vis/run_vis2.py
src/lib/vis/tools.py
src/lib/vis/viewer.py
src/lib/vis/wham_tools/

# third-party: large dirs or ones cloned separately (consistent with README / submodule policy)
/thirdparty/detection
/thirdparty/ZoeDepth
# Patched install copy generated from thirdparty/chumpy_upstream by scripts/setup/fetch_chumpy.sh
/thirdparty/chumpy/

# Any4D (vendor tree): our injected scripts + local indexes, demo assets and batch logs are not tracked.
# (the injected scripts leak internal dataset names/paths; the public export ships only Any4D's core)
/thirdparty/Any4D/scripts/
/thirdparty/Any4D/test.py
/thirdparty/Any4D/video_list_*.txt
/thirdparty/Any4D/run_*.sh
/thirdparty/Any4D/flat_episode_list.json
/thirdparty/Any4D/assets/
/thirdparty/Any4D/scripts/vitra_check_errors.txt
/thirdparty/Any4D/egodex_video_list_*.txt
/thirdparty/Any4D/vitra_check_results/
/thirdparty/Any4D/vitra_check_results_old/

# DPVO (vendor tree): build artifacts, locally-extracted Eigen (*.pth already covered by the global rule)
/thirdparty/DPVO/build/
/thirdparty/DPVO/thirdparty/eigen-3.4.0/
/thirdparty/DPVO/eigen-3.4.0.zip

