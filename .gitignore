**/weights/
**/checkpoints/
*.pth
*.pt
*.ckpt
*.safetensors
*.onnx
*.engine
*.trt

# data and packaging
/datasets/
/dataset*/
/dataset_tars/
/dataset_untars/
_DATA.zip
*.zip
/*.zip

# pretrained / SMPL / MANO etc. (large)
data/pretrain/*.pth
data/pretrain/*.pth.tar
data/smpl/SMPL_*.pkl
*.pkl
# _DATA = MANO assets (obtained separately from HaWoR's data download / the MANO site; not shipped)
/_DATA/

