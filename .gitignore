# =============================================================================
# EgoSmith — data, weights, experiment artifacts (do not commit large files)
# =============================================================================

# deprecated code: fully untracked (see "Internal trees" section below)
.codex

# batch_infer default run dir and temp dir (HAWOR_BATCH_TMPDIR overrides the .tmp location)
/batch_runs/
/.tmp/
/tmp_rerun_meta/
/tmp_rerun_meta2/

# weights & checkpoints (download on demand; the README has the scripts)
/weights/
/checkpoints/
